{
  "name": "@tangtang/core",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "탱탱: 프로젝트별 문맥과 검증을 바탕으로 모델과 협력하는 독립 실행 코어",
  "main": "src/core.js",
